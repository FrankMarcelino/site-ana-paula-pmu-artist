---
import { Image } from 'astro:assets';
import { SERVICOS, reais, type Servico } from '../data/ana';
import microSobrancelhas from '../assets/servicos/micro-sobrancelhas.jpg';
import microLabial from '../assets/servicos/micro-labial.jpg';
import browLamination from '../assets/servicos/brow-lamination.jpg';
import hydraGloss from '../assets/servicos/hydra-gloss.jpg';

interface Props { pagina?: Servico['pagina']; comLink?: boolean }
const { pagina, comLink = false } = Astro.props;
const FOTO = { 'micro-sobrancelhas': microSobrancelhas, 'micro-labial': microLabial, 'brow-lamination': browLamination, 'hydra-gloss': hydraGloss };
const ALT = {
  'micro-sobrancelhas': 'Sobrancelha com micropigmentação fio a fio',
  'micro-labial': 'Lábios com micropigmentação',
  'brow-lamination': 'Sobrancelhas após brow lamination',
  'hydra-gloss': 'Lábios após hydra gloss',
};
const lista = pagina ? SERVICOS.filter((s) => s.pagina === pagina) : SERVICOS;
const base = import.meta.env.BASE_URL;
---
<ul class="cardapio">
  {lista.map((s) => (
    <li>
      <Image quality={70} src={FOTO[s.id as keyof typeof FOTO]} alt={ALT[s.id as keyof typeof ALT]} width={208} height={208} densities={[1, 2]} loading="lazy" />
      <div>
        <h3>{comLink ? <a href={`${base}${s.pagina}/`}>{s.nome}</a> : s.nome}</h3>
        <p>{s.detalhe}</p>
      </div>
      <span class="preco">{reais(s.preco)}{s.retoque && <small>retoque {reais(s.retoque)}</small>}</span>
    </li>
  ))}
</ul>
