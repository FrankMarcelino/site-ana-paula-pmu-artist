---
import { Image } from 'astro:assets';
import { SERVICOS, reais, type Pagina } from '../data/ana';
import { FOTOS } from '../data/galeria';

interface Props { pagina?: Pagina; comLink?: boolean }
const { pagina, comLink = false } = Astro.props;
const lista = SERVICOS.filter((s) => (pagina ? s.pagina === pagina : true));
---
<ul class="cardapio">
  {lista.map((s) => {
    const f = FOTOS[s.foto];
    return (
      <li>
        <Image src={f.src} alt={s.nome} width={208} height={208} densities={[1, 2]} quality={70} loading="lazy" class={f.girar ? 'foto-girada' : undefined} style={f.foco ? `object-position:${f.foco}` : undefined} />
        <div>
          <h3>{comLink ? <a href={`/${s.pagina}/`}>{s.nome}</a> : s.nome}</h3>
          <p>{s.detalhe}</p>
        </div>
        <span class="preco">{reais(s.preco)}{s.observacao && <small>{s.observacao}</small>}</span>
      </li>
    );
  })}
</ul>
