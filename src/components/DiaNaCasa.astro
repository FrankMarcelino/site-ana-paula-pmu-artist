---
// Faixa de prova social (logo abaixo do topo): a montagem de um dia de atendimento, rodando sozinha atrás de uma
// cortina. O desfoque está gravado no vídeo (preparado a partir de midia-original/brutos/
// ana-trabalhando.mp4): quem baixar o arquivo também não vê rosto. As dobras do tecido são CSS.
// Só baixa o vídeo quando um quarto da faixa já está na tela e pausa quando sai. Com "reduzir
// movimento" (no Windows: Efeitos de animação desligados) ou economia de dados fica a capa
// parada (sem botão, decisão do Frank em 24/10).
import chamada from '../data/chamada-escrita.json';
// ordem da escrita: o índice corre pelas três linhas, letra por letra
let n = 0;
const linhas = chamada.linhas.map((l) => ({ ...l, glifos: l.glifos.map((d) => ({ d, i: n++ })) }));
---
<section class="dia-casa" aria-labelledby="titulo-dia">
  <video class="dia-casa-video" muted loop playsinline preload="none" poster="/videos/dia-na-casa-rosa.webp" data-src="/videos/dia-na-casa-rosa.mp4" aria-hidden="true"></video>
  <div class="dia-casa-cortina" aria-hidden="true"></div>
  <div class="dia-casa-texto miolo">
    <h2 id="titulo-dia" class="dia-casa-titulo">
      <span class="visualmente-oculto">Milhares de clientes já passaram por aqui. A próxima pode ser você.</span>
      <svg class="escrita" viewBox={`0 0 ${chamada.largura} ${chamada.altura}`} aria-hidden="true" focusable="false">
        {linhas.map((l) => (
          <g transform={`translate(${l.dx} 0)`}>
            {l.glifos.map((g) => <path d={g.d} pathLength="1" style={`--i:${g.i}`} />)}
          </g>
        ))}
      </svg>
    </h2>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('.dia-casa-video')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches
    || (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  // Escrita à mão: esconde a chamada e escreve quando a faixa aparece, uma vez só.
  // Sem JavaScript ou com "reduzir movimento", a chamada já aparece escrita.
  const escrita = document.querySelector('.escrita');
  if (escrita && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    escrita.classList.add('vai-escrever');
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { escrita.classList.add('escrevendo'); io.disconnect(); }
    }, { threshold: .5 });
    io.observe(escrita);
  }
  if (!calmo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!video.src) video.src = video.dataset.src!; video.play().catch(() => {}); }
      else if (!video.paused) video.pause();
    }, { threshold: .25 }).observe(video); // sem antecipar: logo abaixo do topo, a margem baixaria o vídeo junto com a página
  }
</script>
