---
// Abaixo do botão do WhatsApp: abre o chat da LIVIA com a Belle, a assistente de IA.
interface Props { classe?: string }
const { classe = '' } = Astro.props;
---
<button type="button" class={`fale-belle ${classe}`} aria-label="Fale com a Belle, assistente de IA da Ana Paula. Agendamento rápido" onclick="window.abrirBelle && window.abrirBelle()">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
  <span>Fale com a Belle<small>assistente de IA da Ana Paula</small></span>
  <em class="fale-belle-selo"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>Agendamento rápido</em>
</button>
