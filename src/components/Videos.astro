---
// preload="none": a página não baixa nenhum byte do vídeo até a pessoa apertar o play.
import { VIDEOS, type Pagina } from '../data/ana';
interface Props { limite?: number; pagina?: Pagina }
const { limite, pagina } = Astro.props;
let lista = pagina ? VIDEOS.filter((v) => v.pagina === pagina) : VIDEOS;
if (limite) lista = lista.slice(0, limite);
---
<ul class="videos">
  {lista.map((v) => (
    <li>
      <video controls playsinline preload="none" poster={`/videos/${v.arquivo}.webp`} width="720" height="1280">
        <source src={`/videos/${v.arquivo}.mp4`} type="video/mp4" />
      </video>
      <h3>{v.titulo}</h3>
      <p>{v.descricao}</p>
    </li>
  ))}
</ul>
