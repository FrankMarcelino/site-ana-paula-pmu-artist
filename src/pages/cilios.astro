---
import Base from '../layouts/Base.astro';
import Agendar from '../components/Agendar.astro';
import Cardapio from '../components/Cardapio.astro';
import Videos from '../components/Videos.astro';
import Perguntas from '../components/Perguntas.astro';
import Galeria from '../components/Galeria.astro';
import { INSTAGRAM, PAGAMENTO } from '../data/ana';
const msg = 'Olá, Ana! Quero agendar extensão de cílios.';
// Treinamento da Belle.
const perguntas = [
  { p: 'Quanto tempo leva?', r: 'A extensão de cílios leva cerca de 2 horas.' },
  { p: 'Caíram alguns fios logo depois da aplicação. E agora?', r: 'Se alguns fios caírem pouco tempo depois da aplicação, a Ana Paula faz a reposição sem custo. É só avisar para agendar a correção.' },
  { p: 'Como posso pagar?', r: PAGAMENTO },
];
---
<Base titulo="Extensão de cílios em Juazeiro do Norte | Ana Paula Almeida" descricao="Extensão e manutenção de cílios em Juazeiro do Norte com Ana Paula Almeida. Valores e agendamento pelo WhatsApp." mensagemAgendar={msg}>
  <section class="pagina-topo miolo">
    <h1>Cílios</h1>
    <p>Olhar marcado logo ao acordar: extensão de cílios e manutenção com a Ana Paula, no Miss Belle.</p>
  </section>

  <section class="secao secao--branca" aria-labelledby="t-precos">
    <div class="miolo">
      <h2 id="t-precos" class="titulo-secao titulo-secao--menor">Valores</h2>
      <Cardapio pagina="cilios" />
      <div class="acoes"><Agendar mensagem={msg} /></div>
    </div>
  </section>

  <section class="secao secao--rosa" aria-labelledby="t-resultados">
    <div class="miolo">
      <h2 id="t-resultados" class="titulo-secao titulo-secao--menor">Resultados</h2>
      <p class="intro-secao">Mais trabalhos no <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram @anapaula_pmu_artist</a>.</p>
      <Galeria pagina="cilios" />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-video">
    <div class="miolo">
      <h2 id="t-video" class="titulo-secao titulo-secao--menor">Antes e depois</h2>
      <Videos pagina="cilios" />
    </div>
  </section>

  <section class="secao secao--branca" aria-labelledby="t-perguntas">
    <div class="miolo">
      <h2 id="t-perguntas" class="titulo-secao titulo-secao--menor">Perguntas frequentes</h2>
      <Perguntas lista={perguntas} />
      <div class="acoes"><Agendar mensagem={msg} /></div>
    </div>
  </section>
</Base>
