---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Agendar from '../components/Agendar.astro';
import Fio from '../components/Fio.astro';
import FaleComBelle from '../components/FaleComBelle.astro';
import Cardapio from '../components/Cardapio.astro';
import Videos from '../components/Videos.astro';
import capa from '../assets/ana/capa.jpg';
import logoVinho from '../assets/logo-vinho.svg';
import fachada from '../assets/espaco/fachada.jpeg';
import { INSTAGRAM, whatsapp } from '../data/ana';
---
<Base titulo="Ana Paula Almeida | Micropigmentação em Juazeiro do Norte" descricao="Micropigmentação de sobrancelhas e lábios em Juazeiro do Norte, com Ana Paula Almeida. Veja preços, vídeos e agende pelo WhatsApp.">
  <section class="topo miolo" aria-labelledby="nome">
    <div class="topo-texto">
      <h1 id="nome" class="topo-nome"><img src={logoVinho.src} width="354" height="35" alt="Ana Paula Almeida" fetchpriority="high"></h1>
      <Fio />
      <p class="topo-oficio">Especialista em sobrancelhas, lábios e cílios, em Juazeiro do Norte.</p>
      <p class="topo-autoridade">Mais de 6 anos de profissão e milhares de atendimentos, inclusive de clientes de fora do país. Trabalho com os produtos mais reconhecidos do mercado e sigo estudando a técnica.</p>
      <Agendar />
      <FaleComBelle />
    </div>
    <figure class="topo-foto" style="margin:0">
      <Image quality={70} width={534} src={capa} alt="Ana Paula Almeida no estúdio" widths={[360, 534]} sizes="(min-width: 52rem) 40vw, 100vw" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section class="secao secao--branca" aria-labelledby="titulo-servicos">
    <div class="miolo">
      <h2 id="titulo-servicos" class="titulo-secao">Serviços</h2>
      <p class="intro-secao">Os principais serviços. A avaliação é gratuita, e a micropigmentação sai em até 3x sem juros.</p>
      <Cardapio destaques comLink />
      <div class="acoes">
        <Agendar mensagem="Olá, Ana! Quero saber sobre os serviços." />
        <a class="link-forte" href={`/sobrancelhas/`}>Sobrancelhas</a>
        <a class="link-forte" href={`/labios/`}>Lábios</a>
        <a class="link-forte" href={`/cilios/`}>Cílios</a>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="titulo-videos">
    <div class="miolo">
      <h2 id="titulo-videos" class="titulo-secao">Vídeos</h2>
      <p class="intro-secao">Alguns procedimentos do começo ao fim.</p>
      <Videos limite={2} />
      <div class="acoes">
        <a class="link-forte" href={`/videos/`}>Ver todos os vídeos</a>
        <a class="link-forte" href={INSTAGRAM} target="_blank" rel="noopener">Mais no Instagram</a>
      </div>
    </div>
  </section>

  <section class="secao secao--rosa" aria-labelledby="titulo-espaco">
    <div class="miolo espaco">
      <div class="espaco-foto"><Image quality={70} width={900} src={fachada} alt="Fachada rosa do estúdio, com jardim de flores na frente" widths={[360, 600, 900]} sizes="(min-width: 52rem) 45vw, 90vw" loading="lazy" /></div>
      <div>
        <h2 id="titulo-espaco" class="titulo-secao titulo-secao--menor">A casa rosa</h2>
        <p class="intro-secao">Um espaço novo, pensado para você se sentir à vontade do começo ao fim do atendimento.</p>
        <a class="link-forte" href={`/espaco/`}>Endereço, horário e fotos do espaço</a>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="titulo-combos" id="combos">
    <div class="miolo">
      <h2 id="titulo-combos" class="titulo-secao titulo-secao--menor">Combos</h2>
      <div class="combos">
        <article class="combo">
          <h3>Sextou</h3>
          <p class="valor">R$ 200 <small>em até 3x no cartão</small></p>
          <ul><li>Brow lamination</li><li>Hydra gloss</li><li>Mimo da Ana</li></ul>
          <a class="link-forte" href={whatsapp('Olá, Ana! Quero reservar o combo Sextou.')} target="_blank" rel="noopener">Reservar o Sextou</a>
        </article>
        <article class="combo">
          <h3>Barbie</h3>
          <p class="valor">R$ 650 <small>em até 6x no cartão</small></p>
          <ul><li>Micropigmentação de sobrancelhas</li><li>Micropigmentação labial</li><li>Mimo da Ana</li><li>1 retoque grátis</li></ul>
          <a class="link-forte" href={whatsapp('Olá, Ana! Quero reservar o combo Barbie. Como funciona?')} target="_blank" rel="noopener">Reservar o Barbie</a>
        </article>
      </div>
    </div>
  </section>
</Base>
