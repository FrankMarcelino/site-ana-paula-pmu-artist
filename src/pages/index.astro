---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Agendar from '../components/Agendar.astro';
import Monograma from '../components/Monograma.astro';
import FaleComBelle from '../components/FaleComBelle.astro';
import Vitrine from '../components/Vitrine.astro';
import Videos from '../components/Videos.astro';
import fotoTopo from '../assets/ana/topo.jpeg';
import logoVinho from '../assets/logo-vinho.svg';
import fachada from '../assets/espaco/fachada.jpeg';
import primavera from '../assets/espaco/primavera-fundo.jpeg';
import { INSTAGRAM, whatsapp } from '../data/ana';
---
<Base titulo="Ana Paula Almeida | Micropigmentação em Juazeiro do Norte" descricao="Micropigmentação de sobrancelhas e lábios em Juazeiro do Norte, com Ana Paula Almeida. Veja preços, vídeos e agende pelo WhatsApp.">
  <section class="topo" aria-labelledby="nome">
    <figure class="topo-foto">
      <Image quality={72} width={1448} src={fotoTopo} alt="Ana Paula Almeida sorrindo" widths={[480, 800, 1200, 1448]} sizes="(min-width: 52rem) 52vw, 100vw" loading="eager" fetchpriority="high" />
    </figure>
    <div class="miolo topo-miolo">
      <div class="topo-texto">
        <Monograma fundo />
        <h1 id="nome" class="topo-nome"><img src={logoVinho.src} width="354" height="35" alt="Ana Paula Almeida"></h1>
        <p class="topo-oficio">Especialista em sobrancelhas, lábios e cílios, em Juazeiro do Norte.</p>
        <p class="topo-autoridade">Mais de 10 anos de experiência em estética feminina e milhares de atendimentos, inclusive de clientes de fora do país. Trabalho com os produtos mais reconhecidos do mercado e sigo estudando a técnica.</p>
        <FaleComBelle />
      </div>
    </div>
  </section>

  <section class="secao combos-secao" aria-labelledby="titulo-combos" id="combos">
    <div class="combos-fundo" aria-hidden="true">
      <Image src={primavera} alt="" width={960} widths={[480, 960]} sizes="(min-width: 52rem) 40vw, 100vw" quality={70} loading="lazy" />
    </div>
    <div class="miolo">
      <h2 id="titulo-combos" class="titulo-secao titulo-secao--menor">Combos deste mês</h2>
      <div class="combos">
        <article class="combo">
          <h3>Beauty Express</h3>
          <p class="valor">R$ 35</p>
          <ul><li>Design de sobrancelhas personalizado</li><li>Tintura inclusa</li><li>Spa labial de mimo</li></ul>
          <a class="combo-reservar" href={whatsapp('Olá, Ana! Quero reservar o combo Beauty Express.')} target="_blank" rel="noopener">Reservar o Beauty Express</a>
        </article>
        <article class="combo">
          <h3>Sextou</h3>
          <p class="valor">R$ 200 <small>em até 3x no cartão</small></p>
          <ul><li>Brow lamination</li><li>Hydra gloss</li><li>Mimo da Ana</li></ul>
          <a class="combo-reservar" href={whatsapp('Olá, Ana! Quero reservar o combo Sextou.')} target="_blank" rel="noopener">Reservar o Sextou</a>
        </article>
        <article class="combo">
          <h3>Barbie</h3>
          <p class="valor">R$ 700 <small>em até 6x no cartão</small></p>
          <ul><li>Micropigmentação de sobrancelhas</li><li>Micropigmentação labial</li><li>Mimo da Ana</li><li>1 retoque grátis</li></ul>
          <a class="combo-reservar" href={whatsapp('Olá, Ana! Quero reservar o combo Barbie. Como funciona?')} target="_blank" rel="noopener">Reservar o Barbie</a>
        </article>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="titulo-servicos">
    <div class="miolo">
      <h2 id="titulo-servicos" class="titulo-secao">Serviços</h2>
      <p class="intro-secao">Toque no serviço para ver todos os valores e mais resultados. A avaliação é gratuita, e a micropigmentação sai em até 3x sem juros.</p>
      <Vitrine />
      <div class="acoes">
        <Agendar mensagem="Olá, Ana! Quero saber sobre os serviços." />
        <a class="link-forte" href={`/sobrancelhas/`}>Sobrancelhas</a>
        <a class="link-forte" href={`/labios/`}>Lábios</a>
        <a class="link-forte" href={`/cilios/`}>Cílios</a>
      </div>
    </div>
  </section>

  <section class="secao secao--branca" aria-labelledby="titulo-videos">
    <div class="miolo">
      <h2 id="titulo-videos" class="titulo-secao">Vídeos</h2>
      <p class="intro-secao">Alguns procedimentos do começo ao fim.</p>
      <Videos limite={3} />
      <div class="acoes">
        <a class="link-forte" href={`/videos/`}>Ver todos os vídeos</a>
        <a class="link-forte" href={INSTAGRAM} target="_blank" rel="noopener">Mais no Instagram</a>
      </div>
    </div>
  </section>

  <section class="casa-rosa" aria-labelledby="titulo-espaco">
    <div class="casa-rosa-foto"><Image quality={65} width={1500} src={fachada} alt="Fachada rosa do estúdio, com jardim de flores na frente" widths={[480, 800, 1200, 1500]} sizes="100vw" loading="lazy" /></div>
    <div class="miolo">
      <div class="casa-rosa-cartao">
        <h2 id="titulo-espaco" class="titulo-secao titulo-secao--menor">A casa rosa</h2>
        <p class="intro-secao">Um espaço novo, pensado para você se sentir à vontade do começo ao fim do atendimento.</p>
        <a class="link-forte" href={`/espaco/`}>Endereço, horário e fotos do espaço</a>
      </div>
    </div>
  </section>

</Base>
