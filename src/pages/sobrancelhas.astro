---
import Base from '../layouts/Base.astro';
import Agendar from '../components/Agendar.astro';
import Cardapio from '../components/Cardapio.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Videos from '../components/Videos.astro';
import Perguntas from '../components/Perguntas.astro';
import Galeria from '../components/Galeria.astro';
import { INSTAGRAM, PAGAMENTO } from '../data/ana';
const msg = 'Olá, Ana! Quero agendar sobrancelhas.';
// Treinamento da Belle (perguntas e respostas da micropigmentação de sobrancelhas).
const perguntas = [
  { p: 'Vou poder ver o formato antes?', r: 'Sim. Antes de qualquer procedimento, a Ana Paula faz uma demonstração completa em lápis, para você visualizar o formato e a técnica escolhida. Esse momento serve para alinhar expectativas e tirar todas as dúvidas.' },
  { p: 'Como funciona o retoque?', r: 'O retoque é a segunda sessão da micropigmentação, feita após 40 dias, se houver necessidade, para aperfeiçoar o resultado. Custa R$ 200 e pode ser parcelado em até 2x sem juros. O valor de retoque vale até 60 dias depois do procedimento.' },
  { p: 'Posso fazer o retoque antes de 40 dias?', r: 'O retoque é feito após 40 dias, quando a cicatrização está completa. Em casos excepcionais, como uma viagem, a antecipação pode ser avaliada pela Ana Paula.' },
  { p: 'Já tenho micropigmentação feita por outra profissional. Dá para fazer por cima?', r: 'Depende de como está o pigmento antigo. Quando ainda está forte, não é possível trabalhar por cima e é preciso fazer a remoção antes. Envie uma foto de como está hoje para a Ana Paula avaliar.' },
  { p: 'Já fiz com a Ana Paula há mais de 1 ano. Quanto custa refazer?', r: 'Quem já fez a micropigmentação com a Ana Paula há mais de 1 ano tem um valor diferenciado para refazer: R$ 300, em até 2x sem juros.' },
  { p: 'Quais são os cuidados depois?', r: '1. Não molhar diretamente as sobrancelhas por 5 dias.\n2. Não arrancar a casquinha quando ela se formar.\n3. Higienizar com algodão e água filtrada durante 5 dias, pela manhã e à noite.\n4. Aplicar a pomada cicatrizante após a higienização, conforme a orientação da profissional.\n5. Evitar bebidas alcoólicas por 10 dias.\n6. Evitar carne de porco, peixes e frutos do mar durante a cicatrização.\n7. Evitar secador, sauna e vapores quentes.\n8. Não entrar em piscina ou praia por 15 dias.\n9. Não usar maquiagem ou qualquer outro produto sobre as sobrancelhas por 24 dias.\n10. Beber bastante água para ajudar na cicatrização.\n11. Não praticar atividades físicas por no mínimo 5 dias.' },
  { p: 'Como posso pagar?', r: PAGAMENTO },
];
---
<Base titulo="Micropigmentação de sobrancelhas em Juazeiro do Norte | Ana Paula Almeida" descricao="Micropigmentação de sobrancelhas fio a fio, brow lamination, design com henna e tintura em Juazeiro do Norte. Preços, cuidados e agendamento pelo WhatsApp." mensagemAgendar={msg}>
  <section class="pagina-topo miolo">
    <h1>Sobrancelhas</h1>
    <p>Micropigmentação fio a fio para preencher e desenhar, e design para valorizar os fios que você já tem. Cada procedimento respeita o formato do rosto e a beleza natural.</p>
  </section>

  <section class="secao secao--branca" aria-labelledby="t-precos">
    <div class="miolo">
      <h2 id="t-precos" class="titulo-secao titulo-secao--menor">Valores</h2>
      <p class="intro-secao">A avaliação é gratuita.</p>
      <Cardapio pagina="sobrancelhas" />
      <div class="acoes"><Agendar mensagem={msg} /></div>
    </div>
  </section>

  <section class="secao" aria-labelledby="t-como">
    <div class="miolo">
      <h2 id="t-como" class="titulo-secao titulo-secao--menor">Como funciona a micropigmentação</h2>
      <ComoFunciona />
    </div>
  </section>

  <section class="secao secao--rosa" aria-labelledby="t-resultados">
    <div class="miolo">
      <h2 id="t-resultados" class="titulo-secao titulo-secao--menor">Resultados</h2>
      <p class="intro-secao">Clientes da Ana Paula, logo depois do procedimento e já cicatrizadas. Mais trabalhos no <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram @anapaula_pmu_artist</a>.</p>
      <Galeria pagina="sobrancelhas" />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-video">
    <div class="miolo">
      <h2 id="t-video" class="titulo-secao titulo-secao--menor">A técnica em vídeo</h2>
      <Videos pagina="sobrancelhas" />
    </div>
  </section>

  <section class="secao secao--branca" aria-labelledby="t-perguntas">
    <div class="miolo">
      <h2 id="t-perguntas" class="titulo-secao titulo-secao--menor">Perguntas frequentes</h2>
      <Perguntas lista={perguntas} />
      <div class="acoes"><Agendar mensagem={msg} /></div>
    </div>
  </section>
</Base>
